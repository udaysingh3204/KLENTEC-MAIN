# ── Supabase (Database & Auth) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# ── Resend (Email Notifications) ────────────────────────────────────
# Server-side only (used by api/send-email.js) — never expose this to the
# browser. Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# klentec.com is verified in Resend (as of Sep 2026), so this can send
# from the real domain. If the domain ever falls out of verified status,
# fall back to "KLENTEC <onboarding@resend.dev>" temporarily.
RESEND_FROM_EMAIL=KLENTEC <hello@klentec.com>
# Inbox that receives new-lead notifications.
ADMIN_NOTIFICATION_EMAIL=hello@klentec.com

# ── Test Mode Toggles ─────────────────────────────────────────────
# Set to true for development/testing
VITE_ENABLE_TEST_MODE=false

# ── Application Settings ──────────────────────────────────────────
VITE_APP_URL=https://klentec.com
VITE_APP_ENV=production
