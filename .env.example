# ── Supabase (Database & Auth) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# ── Resend (Email Notifications) ────────────────────────────────────
# Server-side only (used by api/send-email.js) — never expose this to the
# browser. Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be onboarding@resend.dev until your sending domain is verified in
# Resend, e.g. "KLENTEC <onboarding@resend.dev>". Once klentec.com is
# verified, switch to "KLENTEC <hello@klentec.com>".
RESEND_FROM_EMAIL=KLENTEC <onboarding@resend.dev>
# Inbox that receives new-lead notifications.
ADMIN_NOTIFICATION_EMAIL=hello@klentec.com

# ── Payment Gateways ────────────────────────────────────────────────

# Razorpay (India - INR)
# Get from: Dashboard → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
VITE_RAZORPAY_KEY_SECRET=xxxxxxxxxxxxx

# Stripe (USA - USD)
# Get from: Dashboard → Developers → API Keys → Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
VITE_STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# Telr (Middle East - AED/SAR)
# Get from: Merchant Dashboard → Settings → Store Configuration
VITE_TELR_STORE_ID=xxxxxxxxxxxxx
VITE_TELR_API_KEY=xxxxxxxxxxxxx

# ── API Configuration ──────────────────────────────────────────────
# Backend API URL for payment processing
VITE_API_URL=https://your-api-domain.com
# Or for development:
# VITE_API_URL=http://localhost:3000

# ── Webhooks (for backend) ────────────────────────────────────────
# Configure these URLs in payment gateway dashboards
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=xxxxxxxxxxxxx
TELR_WEBHOOK_SECRET=xxxxxxxxxxxxx

# ── Test Mode Toggles ─────────────────────────────────────────────
# Set to true for development/testing
VITE_ENABLE_TEST_MODE=false

# ── Application Settings ──────────────────────────────────────────
VITE_APP_URL=https://klentec.com
VITE_APP_ENV=production
